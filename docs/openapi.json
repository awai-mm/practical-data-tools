        },
        "responses": {
          "200": {
            "description": "Deterministic solver execution result.",
            "content": {
              "application/json": {
                "schema": {
                  "type": "object",
                  "properties": {
                    "ok": {
                      "type": "boolean"
                    },
                    "solver": {
                      "type": "string",
                      "const": "inspect_csv_integrity"
                    },
                    "b2a_gate": {
                      "type": "object"
                    }
                  }
                }
              }
            }
          },
          "402": {
            "description": "HTTP 402 Payment Required — Free trial quota exceeded; contains L402 Lightning and x402 USDC challenge payloads.",
            "headers": {
              "WWW-Authenticate": {
                "schema": {
                  "type": "string"
                },
                "description": "L402 macaroon=\"...\", invoice=\"lnbc...\""
              }
            }
          }
        }
      }
    }
  }
